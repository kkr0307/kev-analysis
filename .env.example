# "json" (default, primary) or "mongo" (force MongoDB only).
# When DATA_SOURCE=json and the JSON file below is missing/empty, the app
# automatically falls back to MongoDB -- no setup required to try it.
DATA_SOURCE=json

# Primary data file when DATA_SOURCE=json, and the seed source for MongoDB.
KEV_JSON_PATH=data/known_exploited_vulnerabilities.json

# Used as the fallback when the JSON file is unavailable, or when DATA_SOURCE=mongo.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kev_db
MONGO_COLLECTION=vulnerabilities

FLASK_DEBUG=1
